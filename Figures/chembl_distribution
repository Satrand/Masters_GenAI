import io
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

from PIL import Image, ImageChops

from rdkit import Chem
from rdkit.Chem import AllChem
from rdkit.Chem.Draw import rdMolDraw2D

# -----------------------------
# INPUT
# -----------------------------
input_path = "/scratch/prj/rcmb_genai_transition/chembl_36/chembl_36_sqlite/chembl_36_smiles.csv"
chunk_size = 100000

heavy_atoms_list = []
smiles_list = []

def safe_heavy_atoms(smi):
    mol = Chem.MolFromSmiles(smi)
    if mol is None:
        return None
    return mol.GetNumHeavyAtoms()

print("Processing ChEMBL...")

for chunk in pd.read_csv(input_path, chunksize=chunk_size):

    chunk = chunk[
        ~chunk["canonical_smiles"].astype(str).str.contains(r"\.", regex=True)
    ]

    for smi in chunk["canonical_smiles"]:
        ha = safe_heavy_atoms(smi)

        if ha is not None:
            heavy_atoms_list.append(ha)
            smiles_list.append(smi)

# -----------------------------
# DATASET
# -----------------------------
df_all = pd.DataFrame(
    {"smiles": smiles_list, "heavy_atoms": heavy_atoms_list}
)

print(f"Total valid molecules: {len(df_all)}")

# -----------------------------
# SETTINGS
# -----------------------------
cutoff = 34

x_max = int(np.ceil(df_all["heavy_atoms"].quantile(0.99)))
df_plot = df_all[df_all["heavy_atoms"] <= x_max]

# -----------------------------
# REPRESENTATIVES
# -----------------------------
df_sorted = df_all.sort_values("heavy_atoms").reset_index(drop=True)

smallest = df_sorted.iloc[int(len(df_sorted) * 0.01)]
median = df_sorted.iloc[len(df_sorted) // 2]
largest = df_sorted.iloc[-1]

print("\n--- REPRESENTATIVE MOLECULES ---")

for name, row in [
    ("SMALL", smallest),
    ("MEDIAN", median),
    ("LARGE", largest),
]:
    mol = Chem.MolFromSmiles(row["smiles"])

    if mol is None:
        print(name, "INVALID SMILES")
        continue

    formula = Chem.rdMolDescriptors.CalcMolFormula(mol)

    print(f"\n{name}")
    print("SMILES :", row["smiles"])
    print("Formula:", formula)
    print("Heavy atoms:", row["heavy_atoms"])


mols = [
    Chem.MolFromSmiles(smallest["smiles"]),
    Chem.MolFromSmiles(median["smiles"]),
    Chem.MolFromSmiles(largest["smiles"]),
]

for mol in mols:
    AllChem.Compute2DCoords(mol)

labels = [
    f"Small molecule\n{smallest['heavy_atoms']} heavy atoms",
    f"Median molecule\n{median['heavy_atoms']} heavy atoms",
    f"Largest molecule\n{largest['heavy_atoms']} heavy atoms",
]

# -----------------------------
# RDKit RENDERING (BIG + COLORED)
# -----------------------------
def trim(im):
    """Crop away white borders."""
    bg = Image.new(im.mode, im.size, (255, 255, 255))
    diff = ImageChops.difference(im.convert("RGB"), bg)
    bbox = diff.getbbox()
    if bbox:
        return im.crop(bbox)
    return im


def draw_scaled_molecule(mol, size=(4000, 4000), padding=0.02, font_size=80, scale=1.0):

    drawer = rdMolDraw2D.MolDraw2DCairo(*size)
    opts = drawer.drawOptions()

    opts.padding = padding

    opts.fixedFontSize = font_size
    opts.minFontSize = font_size
    opts.maxFontSize = font_size
    opts.bondLineWidth = 5
    opts.multipleBondOffset = 0.35

    drawer.DrawMolecule(mol)
    drawer.FinishDrawing()

    #png = drawer.GetDrawingText()

    img = Image.open(io.BytesIO(drawer.GetDrawingText()))
    img = trim(img)

    if scale != 1.0:
        img = img.resize(
            (
                int(img.width * scale),
                int(img.height * scale),
            ),
            Image.Resampling.LANCZOS,
        )

    return img
mol_images = [
    draw_scaled_molecule(mols[0], size=(2200, 2600), padding=0.01, font_size=130),
    draw_scaled_molecule(mols[1], size=(2200, 2600), padding=0.02, font_size=100),
    draw_scaled_molecule(mols[2], size=(3500, 5000), padding=0.0, scale=1.35),   # much larger
]

# -----------------------------
# FIGURE LAYOUT
# -----------------------------
fig = plt.figure(figsize=(15, 16), dpi=200)

gs = fig.add_gridspec(
    5, 3,
    height_ratios=[3.0, 3.0, 0.15, 0.5, 7.5]
)

# -----------------------------
# PANEL A
# -----------------------------
ax1 = fig.add_subplot(gs[:2, :])

bins = np.arange(0, x_max + 2, 2)

ax1.hist(df_plot["heavy_atoms"], bins=bins, edgecolor="black")

ax1.axvline(cutoff, linestyle="--", linewidth=3, color="red")


ax1.set_xlim(0, x_max)

ax1.set_title("A. Heavy Atom Distribution in ChEMBL", fontsize=24, pad=12)
ax1.set_xlabel("Heavy atom count", fontsize=20)
ax1.set_ylabel("Number of molecules", fontsize=20)
ax1.tick_params(labelsize=16)

# -----------------------------
# TITLE
# -----------------------------
ax_title = fig.add_subplot(gs[3, :])
ax_title.axis("off")

ax_title.text(
    0.5, 0.5,
    "B. Structures Representing the Molecular Size Distribution",
    ha="center",
    va="center",
    fontsize=26,
)

# -----------------------------
# PANEL B
# -----------------------------

gs_bottom = gs[4, :].subgridspec(
    2, 2,
    height_ratios=[1.2, 3.8],   # give the largest molecule more room
    width_ratios=[1, 1],
    hspace=0.15,
    wspace=0.25,
)

# Top row
ax_small = fig.add_subplot(gs_bottom[0, 0])
ax_median = fig.add_subplot(gs_bottom[0, 1])

# Bottom row (spans both columns)
ax_large = fig.add_subplot(gs_bottom[1, :])

axes = [ax_small, ax_median, ax_large]

# -----------------------------
# IMAGES
# -----------------------------

for i, (ax, img) in enumerate(zip(axes, mol_images)):

    if i == 2:
        # Shift only the largest molecule downward inside its axis
        shift = int(img.height * 0.25)
        
        ax.imshow(
            img,
            interpolation="nearest",
            aspect="equal",
            extent=[
                0,
                img.width,
                img.height + shift,
                shift
            ]
        )

        ax.set_ylim(img.height + shift, 0)

    else:
        ax.imshow(
            img,
            interpolation="nearest",
            aspect="equal"
        )

        ax.set_ylim(img.height, 0)

    ax.set_xlim(0, img.width)
    ax.axis("off")
    ax.set_anchor("C")
# -----------------------------
# LABELS
# -----------------------------

fig.canvas.draw()

for ax, label in zip(axes, labels):

    bbox = ax.get_position()

    fig.text(
        bbox.x0 + bbox.width / 2,
        bbox.y0 - 0.05,
        label,
        ha="center",
        va="top",
        fontsize=15,
    )
# -----------------------------
# FINAL SPACING
# -----------------------------
plt.subplots_adjust(
    top=0.95,
    bottom=0.08,
    hspace=0.35,
    wspace=0.35
)

plt.savefig(
    "Figure3_chembl_distribution.png",
    dpi=600,
    bbox_inches="tight",
)

plt.show()
